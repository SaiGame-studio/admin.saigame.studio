		{
			"name": "Player — Quest Progress",
			"description": "Player-facing endpoints for quest progress, event recording, and reward claiming.",
			"item": [
				{
					"name": "Get Player Quests",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Has quests array', () => pm.expect(pm.response.json()).to.have.property('quests'));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
						"url": {
							"raw": "{{api_url}}/api/v1/games/{{game_id}}/quests?status=in_progress&limit=50&offset=0",
							"host": ["{{api_url}}"],
							"path": ["api", "v1", "games", "{{game_id}}", "quests"],
							"query": [
								{ "key": "status", "value": "in_progress", "description": "Filter by status: in_progress | completed | claimed | expired. Omit for all." },
								{ "key": "limit", "value": "50" },
								{ "key": "offset", "value": "0" }
							]
						}
					}
				},
				{
					"name": "Get Quest Chain with Progress",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
