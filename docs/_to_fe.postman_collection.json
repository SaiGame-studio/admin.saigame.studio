      "item": [
        {
          "name": "Create Quest Definition",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('access_token')) console.log('⚠ access_token not set');",
                  "if (!pm.environment.get('studio_id')) console.log('⚠ studio_id not set');",
                  "if (!pm.environment.get('game_id')) console.log('⚠ game_id not set');"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has id', () => pm.expect(pm.response.json()).to.have.property('id'));",
                  "const j = pm.response.json();",
                  "if (j.id) { pm.environment.set('quest_id', j.id); console.log('✓ quest_id:', j.id); }"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"First Blood {{$randomInt}}\",\n    \"description\": \"Kill 10 enemies. {{$randomInt}}\",\n    \"quest_type\": \"one_time\",\n    \"condition_type\": \"enemy_killed\",\n    \"condition_target\": 10,\n    \"condition_metadata\": {},\n    \"quest_chain_id\": null,\n    \"prerequisite_quest_id\": null,\n    \"is_active\": true,\n    \"sort_order\": 0,\n    \"rewards\": [\n        { \"reward_type\": \"coin\", \"amount\": 100 },\n        { \"reward_type\": \"item\", \"item_definition_id\": \"{{currency_item_id}}\", \"quantity_min\": 1, \"quantity_max\": 1000 }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_url}}/api/v1/studios/{{studio_id}}/games/{{game_id}}/quest-definitions",
